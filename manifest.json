{
  "manifest_version": 3,
  "name": "SRT Macro",
  "description": "SRT 자동 예약 매크로",
  "version": "2.0.0",
  "permissions": [
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "https://etk.srail.co.kr/*",
    "https://etk.srail.kr/*"
  ],
  "icons": {
    "128": "images/icon128.png"
  },
  "content_scripts": [{
    "all_frames": true,
    "js": ["content.js"],
    "matches": [
      "https://etk.srail.co.kr/*",
      "https://etk.srail.kr/*"
    ],
    "run_at": "document_end"
  }],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [{
    "resources": ["images/btn_start.png", "images/btn_stop.png", "assets/tada.mp3"],
    "matches": ["https://etk.srail.co.kr/*", "https://etk.srail.kr/*"]
  }],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
